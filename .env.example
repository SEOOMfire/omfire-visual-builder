# Postgres. Die App spricht als app_runtime, Migrationen als Eigentümer.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
POSTGRES_PASSWORD=
APP_RUNTIME_PASSWORD=

# Öffentliche Adresse des Dienstes, ohne Schrägstrich am Ende.
APP_ORIGIN=
# Signierte Bildlinks. Nur Laufzeit, nie die Bind-Adresse 0.0.0.0.
PUBLIC_BASE_URL=

# Kommagetrennte Mail-Domains, die sich anmelden dürfen. Leer sperrt die Anmeldung.
ALLOWED_EMAIL_DOMAINS=

# email_link, password oder both
AUTH_LOGIN_METHOD=

# log nur lokal, resend in Betrieb
AUTH_EMAIL_DELIVERY=
RESEND_API_KEY=
EMAIL_FROM=

# Erstes OMfire-Konto. Nur beim Ausführen von npm run bootstrap gesetzt.
APP_BOOTSTRAP_EMAIL=
APP_BOOTSTRAP_PASSWORD=
APP_BOOTSTRAP_NAME=
APP_BOOTSTRAP_TENANT_SLUG=
APP_BOOTSTRAP_TENANT_NAME=

# local (Ordner) oder s3 (MinIO, Adapter folgt mit Coolify)
FILE_STORAGE_PROVIDER=
FILE_STORAGE_ROOT=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=

OPENROUTER_API_KEY=
VISUAL_BUILDER_OPENROUTER_MODEL=
VISUAL_BUILDER_OPENROUTER_FALLBACK_MODELS=
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=

GOOGLE_DRIVE_CLIENT_EMAIL=
GOOGLE_DRIVE_PRIVATE_KEY=
GOOGLE_DRIVE_PARENT_FOLDER_ID=
# Ordner „Visual Builder“ in der geteilten Ablage. Leer, bis Drive verbunden ist.
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Optional. Im Image ist /usr/bin/chromium gesetzt.
CHROMIUM_PATH=
# Gleichzeitige Render-Seiten. Standard 2.
RENDER_CONCURRENCY=
# Gleichzeitige Zeilen eines CSV-Auftrags. Standard 2.
BATCH_CONCURRENCY=
